# 이 파일을 backend/.env 로 복사해서 값을 채운다. backend/.env 는 커밋하지 않는다.
# docker-compose(PostgreSQL)와 백엔드가 같은 변수를 쓴다.
POSTGRES_USER=iris
# 비밀번호에는 $ 문자를 쓰지 않는다(docker compose가 변수로 해석해서 백엔드와 값이 달라진다).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iris
POSTGRES_HOST=127.0.0.1
# 이 PC의 다른 PostgreSQL과 겹치지 않도록 5433을 쓴다.
POSTGRES_PORT=5433

# 첫 관리자 계정. 둘 다 설정하면 앱을 처음 시작할 때 이 계정을 만든다(이미 있으면 만들지 않는다).
# 아이디는 영문 소문자와 숫자 4~20자, 비밀번호는 8자 이상. 관리자 웹으로 로그인할 때 쓴다.
# 주의: 예시 값을 그대로 쓰지 말고 직접 정한 값을 넣는다(공개된 비밀번호로 관리자가 만들어진다).
# 비밀번호는 이 줄의 주석을 풀고 무작위 값으로 채운다(예: openssl rand -hex 16).
# ADMIN_LOGIN_ID=admin
# ADMIN_PASSWORD=

# accessToken 서명 키(32자 이상). 비어 있으면 앱이 시작하지 않는다. 직접 무작위 값으로 채운다.
# 이 키가 노출되면 누구나 토큰을 만들 수 있다. 바꾸면 발급된 모든 토큰이 무효가 된다.
# JWT_SECRET=  (주석을 풀고 `openssl rand -hex 32` 의 결과를 넣는다)

# Hermes API 서버. 이 PC의 ~/.hermes/.env 에 API_SERVER_ENABLED=true 와 API_SERVER_KEY=<키> 를 설정하고,
# 같은 키를 여기에 넣는다. 이 키는 Hermes의 terminal 명령 실행까지 열어 주므로 백엔드만 보관한다.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me
