# 이 파일을 backend/.env 로 복사해서 값을 채운다. backend/.env 는 커밋하지 않는다.
# docker-compose(PostgreSQL)와 백엔드가 같은 변수를 쓴다.
POSTGRES_USER=iris
# 비밀번호에는 $ 문자를 쓰지 않는다(docker compose가 변수로 해석해서 백엔드와 값이 달라진다).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iris
POSTGRES_HOST=127.0.0.1
# 이 PC의 다른 PostgreSQL과 겹치지 않도록 5433을 쓴다.
POSTGRES_PORT=5433

# Hermes API 서버. 이 PC의 ~/.hermes/.env 에 API_SERVER_ENABLED=true 와 API_SERVER_KEY=<키> 를 설정하고,
# 같은 키를 여기에 넣는다. 이 키는 Hermes의 terminal 명령 실행까지 열어 주므로 백엔드만 보관한다.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me
